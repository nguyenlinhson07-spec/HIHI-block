<?xml version="1.0" encoding="utf-8"?>
<!-- Launch window shown until Flutter draws its first frame.
     It matches the app's own dark background, so opening the game no longer
     flashes white before the purple UI appears. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/hihi_background" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
